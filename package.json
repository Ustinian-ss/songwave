{
  "name": "songwave",
  "productName": "声浪 SongWave",
  "version": "0.11.0",
  "description": "声浪 SongWave · LX 逻辑音画播放器：播放模式/进度记忆/倍速/定时停止 + 我喜欢/播放历史/搜索历史 + 多平台音源与 lx 音源导入 + WE 壁纸背景 + 可视化",
  "main": "electron/main.js",
  "author": "SongWave",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev:local": "..\\song-life\\node_modules\\.bin\\electron .",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "test": "node scripts/test-renderer.js",
    "test:renderer": "node scripts/test-renderer.js",
    "test:sources": "node scripts/test-sources.js",
    "test:lx": "node scripts/test-lx-runtime.js",
    "test:download": "node scripts/test-download.js",
    "build:dir": "electron-builder --win --dir",
    "test:all": "node scripts/test-renderer.js && node scripts/test-match.js && node scripts/test-wallpaper.js && node scripts/test-download.js && node scripts/test-platforms.js && node scripts/test-wallpaper-engine.js && node scripts/test-source-manager.js && node scripts/test-lx-import.js && node scripts/test-playlist-import.js && node scripts/test-lx-runtime.js",
    "test:wallpaper": "node scripts/test-wallpaper.js",
    "test:platforms": "node scripts/test-platforms.js",
    "test:we": "node scripts/test-wallpaper-engine.js",
    "test:srcmgr": "node scripts/test-source-manager.js",
    "test:lximp": "node scripts/test-lx-import.js",
    "test:plimp": "node scripts/test-playlist-import.js",
    "test:match": "node scripts/test-match.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.songwave.app",
    "productName": "声浪 SongWave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SongWave-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "SongWave-Portable-${version}.exe"
    }
  }
}
